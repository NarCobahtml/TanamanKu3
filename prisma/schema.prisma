generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum ScanStatus {
  DIPROSES
  BERHASIL
  GAGAL
}

enum NotificationType {
  WATERING_REMINDER
  SCAN_RESULT
  FORUM_REPLY
}


model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  bio          String?
  photoUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plants        Plant[]
  scanRecords   ScanRecord[]
  posts         Post[]
  comments      Comment[]
  notifications Notification[]

  @@index([email])
}

model Plant {
  id           String    @id @default(cuid())
  name         String
  type         String    @default("hias")
  kategori     String?   @default("Indoor")
  status       String?   @default("terjadwal")
  nextWater    String?   @default("nw.berikutnyaBesok")
  plantingDate DateTime?
  photoUrl     String?
  notes        String?
  userId       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  wateringSchedule WateringSchedule?
  scans            ScanRecord[]

  @@index([userId])
}

model Disease {
  id             String   @id @default(cuid())
  name           String
  scientificName String?
  description    String
  treatment      String
  prevention     String?
  plantType      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  scans ScanRecord[]
}

model ScanRecord {
  id           String     @id @default(cuid())
  userId       String
  plantId      String?
  diseaseId    String?
  imageUrl     String
  confidence   Float?
  status       ScanStatus @default(DIPROSES)
  errorMessage String?
  createdAt    DateTime   @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plant   Plant?   @relation(fields: [plantId], references: [id], onDelete: SetNull)
  disease Disease? @relation(fields: [diseaseId], references: [id], onDelete: SetNull)
  posts   Post[]

  @@index([userId, createdAt])
}


model WateringSchedule {
  id               String    @id @default(cuid())
  plantId          String    @unique
  nextWateringAt   DateTime
  lastWateredAt    DateTime?
  isAuto           Boolean   @default(true)
  reminderEnabled  Boolean   @default(true)
  reminderMinutes  Int       @default(30)
  weatherCondition String?
  temperatureC     Float?
  humidityPct      Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)
}

model Post {
  id         String   @id @default(cuid())
  authorId   String?
  scanId     String?
  title      String
  content    String
  imageUrl   String?
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author   User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  scan     ScanRecord? @relation(fields: [scanId], references: [id], onDelete: SetNull)
  comments Comment[]

  @@index([authorId, createdAt])
}

model Comment {
  id         String   @id @default(cuid())
  postId     String
  authorId   String?
  content    String
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  post   Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([postId])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  body        String
  relatedId   String?
  relatedType String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
